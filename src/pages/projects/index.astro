---
import type { CollectionEntry } from 'astro:content';
import SectionGlyph from '../../components/SectionGlyph.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

type ProjectCategory = 'coding' | 'leatherworking' | 'woodworking' | 'animation';

const SECTION_CONFIG: readonly {
  category: ProjectCategory;
  title: string;
  blurb: string;
}[] = [
  {
    category: 'coding',
    title: 'Coding',
    blurb: 'Software, systems, and tools.',
  },
  {
    category: 'leatherworking',
    title: 'Leatherworking',
    blurb: 'Bags, wallets, and small goods.',
  },
  {
    category: 'woodworking',
    title: 'Woodworking',
    blurb: 'Furniture, shop projects, and builds.',
  },
  {
    category: 'animation',
    title: 'Animation',
    blurb: 'Stop-motion and moving-image work.',
  },
];

const projects = await getCollection('projects');
projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function byCategory(cat: ProjectCategory): CollectionEntry<'projects'>[] {
  return projects.filter((p) => p.data.category === cat);
}

let cardIndex = 0;
---

<BaseLayout title="Projects | Bryce Roberts">
  <section class="page-header">
    <div class="header-content fade-in-up">
      <h1 class="heading-with-icon">
        <SectionGlyph kind="projects" size={42} />
        Projects
      </h1>
      <div class="divider"></div>
      <p class="subtitle">Code, leather, and wood: work across different media.</p>
    </div>
  </section>

  {
    SECTION_CONFIG.map((sec) => {
      const sectionProjects = byCategory(sec.category);
      return (
        <section class="project-section" aria-labelledby={`section-${sec.category}`}>
          <div class="section-intro">
            <h2 id={`section-${sec.category}`} class="section-title">
              {sec.title}
            </h2>
            <p class="section-blurb">{sec.blurb}</p>
          </div>
          {sectionProjects.length === 0 ? (
            <p class="section-empty">Nothing here yet.</p>
          ) : (
            <div class="projects-grid">
              {sectionProjects.map((project) => {
                cardIndex += 1;
                const delay = 0.1 * cardIndex;
                return (
                  <a
                    href={`/projects/${project.id}`}
                    class="project-card glass-card fade-in-up"
                    style={`animation-delay: ${delay}s;`}
                  >
                    <div class="card-content">
                      <div class="card-header">
                        <h3>{project.data.title}</h3>
                        <time class="card-date" datetime={project.data.date.toISOString()}>
                          {project.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
                          {project.data.endDate && ` – ${project.data.endDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}`}
                        </time>
                      </div>
                      <p>{project.data.description}</p>
                    </div>
                  </a>
                );
              })}
            </div>
          )}
        </section>
      );
    })
  }
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
    color: var(--text-bright);
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--text-main);
    margin-top: 1.5rem;
  }

  .divider {
    height: 3px;
    width: 60px;
    background: var(--accent);
    border-radius: 2px;
  }

  .project-section {
    margin-bottom: clamp(3rem, 8vw, 4.5rem);
  }

  .project-section:last-of-type {
    margin-bottom: 0;
  }

  .section-intro {
    margin-bottom: 1.5rem;
  }

  .section-title {
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-bright);
    margin: 0 0 0.35rem;
  }

  .section-blurb {
    margin: 0;
    font-size: 0.98rem;
    color: var(--text-main);
    line-height: 1.5;
    max-width: 40rem;
  }

  .section-empty {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-main);
    opacity: 0.85;
    font-style: italic;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    cursor: pointer;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .project-card h3 {
    font-size: 1.25rem;
    margin: 0;
    color: var(--text-bright);
    transition: color 0.2s ease;
  }

  .project-card:hover h3 {
    color: var(--accent);
  }

  .project-card p {
    color: var(--text-main);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
    flex-grow: 1;
  }

  .card-date {
    display: block;
    font-size: 0.8rem;
    color: var(--text-main);
    opacity: 0.6;
    font-family: var(--font-mono);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .fade-in-up {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
