---
/** Stroke icons aligned with Feather / Lucide; use currentColor */
export type SectionGlyphKind = 'home' | 'projects' | 'garden' | 'resume';

interface Props {
  kind: SectionGlyphKind;
  /** px; nav ~18–20, page headers ~44 */
  size?: number;
  class?: string;
}

const { kind, size = 18, class: className } = Astro.props;
const common = {
  xmlns: 'http://www.w3.org/2000/svg',
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none' as const,
  stroke: 'currentColor',
  'stroke-width': 2,
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  class: ['section-glyph', className].filter(Boolean).join(' '),
  'aria-hidden': 'true' as const,
};
---

{
  kind === 'home' && (
    <svg {...common}>
      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
      <polyline points="9 22 9 12 15 12 15 22" />
    </svg>
  )
}

{
  kind === 'projects' && (
    <svg {...common}>
      <rect width="7" height="7" x="3" y="3" rx="1" />
      <rect width="7" height="7" x="14" y="3" rx="1" />
      <rect width="7" height="7" x="14" y="14" rx="1" />
      <rect width="7" height="7" x="3" y="14" rx="1" />
    </svg>
  )
}

{
  kind === 'garden' && (
    <svg {...common}>
      <line x1="6" x2="6" y1="3" y2="15" />
      <circle cx="18" cy="6" r="3" />
      <circle cx="6" cy="18" r="3" />
      <path d="M18 9a9 9 0 0 1-9 9" />
    </svg>
  )
}

{
  kind === 'resume' && (
    <svg {...common}>
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
      <circle cx="12" cy="7" r="4" />
    </svg>
  )
}

<style>
  .section-glyph {
    flex-shrink: 0;
    color: inherit;
  }
</style>
