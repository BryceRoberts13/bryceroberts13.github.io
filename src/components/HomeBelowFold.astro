---
import SectionGlyph from './SectionGlyph.astro';
import type { SectionGlyphKind } from './SectionGlyph.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const PREVIEW_LIMIT = 6;

const categoryLabels: Record<string, { label: string; color: string }> = {
  coding: { label: 'Code', color: 'var(--accent-link)' },
  leatherworking: { label: 'Leather', color: 'var(--accent-secondary)' },
  woodworking: { label: 'Wood', color: 'var(--accent-success)' },
  animation: { label: 'Animation', color: 'var(--accent)' },
};

function previewDate(d: Date) {
  const y = d.getFullYear();
  const nowY = new Date().getFullYear();
  if (y === nowY) {
    return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
  }
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const gardenRaw = await getCollection('garden');
gardenRaw.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const notesItems = gardenRaw.slice(0, PREVIEW_LIMIT).map((e) => ({
  href: `/garden/${e.id}`,
  title: e.data.title,
  date: e.data.date,
}));

const projectsRaw = await getCollection('projects');
projectsRaw.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projectItems = projectsRaw.slice(0, PREVIEW_LIMIT).map((e) => ({
  href: `/projects/${e.id}`,
  title: e.data.title,
  description: e.data.description,
  date: e.data.date,
  category: e.data.category,
}));

const glyphSize = 38;
---

<div class="home-below">
  <!-- Projects as cards -->
  <section class="home-preview-block" aria-labelledby="home-projects-heading">
    <h2 id="home-projects-heading" class="home-preview-heading-host reveal-on-scroll">
      <a href="/projects" class="home-preview-heading heading-with-icon home-preview-heading-link">
        <SectionGlyph kind="projects" size={glyphSize} />
        Projects
      </a>
    </h2>
    <p class="home-preview-subtitle reveal-on-scroll">Software, systems, and things I've built.</p>

    {projectItems.length === 0 ? (
      <p class="home-preview-empty">No projects yet.</p>
    ) : (
      <div class="project-cards-grid">
        {projectItems.map((item, i) => {
          const catInfo = categoryLabels[item.category] || categoryLabels.coding;
          return (
            <a
              href={item.href}
              class="project-card glass-card reveal-on-scroll"
              style={`--reveal-delay: ${0.08 * i}s`}
            >
              <div class="project-card-header">
                <span class="project-category-badge" style={`--badge-color: ${catInfo.color}`}>
                  {catInfo.label}
                </span>
                <time class="project-card-date" datetime={item.date.toISOString()}>
                  {previewDate(item.date)}
                </time>
              </div>
              <h3 class="project-card-title">{item.title}</h3>
              <p class="project-card-desc">{item.description}</p>
            </a>
          );
        })}
      </div>
    )}

    <a href="/projects" class="home-preview-view-all reveal-on-scroll">
      View all projects <span class="home-preview-view-all-arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <!-- Garden as text list -->
  <section class="home-preview-block" aria-labelledby="home-garden-heading">
    <h2 id="home-garden-heading" class="home-preview-heading-host reveal-on-scroll">
      <a href="/garden" class="home-preview-heading heading-with-icon home-preview-heading-link">
        <SectionGlyph kind="garden" size={glyphSize} />
        Garden
      </a>
    </h2>
    <p class="home-preview-subtitle reveal-on-scroll">Thoughts, patch notes, and technical deep dives.</p>

    {notesItems.length === 0 ? (
      <p class="home-preview-empty">No notes yet.</p>
    ) : (
      <ul class="home-preview-list reveal-on-scroll">
        {notesItems.map((item) => (
          <li>
            <a href={item.href} class="home-preview-row">
              <time class="home-preview-time" datetime={item.date.toISOString()}>
                {previewDate(item.date)}
              </time>
              <span class="home-preview-title">{item.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )}

    <a href="/garden" class="home-preview-view-all reveal-on-scroll">
      View all notes <span class="home-preview-view-all-arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <!-- Resume section -->
  <section class="home-preview-block home-resume-block reveal-on-scroll" aria-labelledby="home-resume-heading">
    <h2 id="home-resume-heading" class="home-preview-heading-host">
      <a href="/resume" class="home-preview-heading heading-with-icon home-preview-heading-link">
        <SectionGlyph kind="resume" size={glyphSize} />
        Resume
      </a>
    </h2>
    <p class="home-preview-subtitle">A brief overview of experience and education.</p>
    <p class="home-resume-lead">
      {site.title} —
      <a href="/resume">Resume</a>,{' '}
      <a href={`mailto:${site.contact.email}`}>email</a>, or{' '}
      <a href={site.contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
    </p>
  </section>
</div>

<script>
  function initRevealAnimations() {
    const revealElements = document.querySelectorAll('.reveal-on-scroll');
    if (!revealElements.length) return;

    // Check for reduced motion preference
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      revealElements.forEach((el) => el.classList.add('revealed'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    revealElements.forEach((el) => observer.observe(el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRevealAnimations, { once: true });
  } else {
    initRevealAnimations();
  }
</script>

<style>
  /* Scroll reveal animations */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    transition-delay: var(--reveal-delay, 0s);
  }

  .reveal-on-scroll.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-on-scroll {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .home-below {
    margin-top: clamp(1rem, 3vw, 2rem);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--card-border);
  }

  section.home-preview-block {
    margin-bottom: clamp(3rem, 7vw, 4.5rem);
  }

  section.home-preview-block:last-child {
    margin-bottom: 0;
  }

  .home-preview-heading-host {
    margin: 0 0 0.35rem;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
  }

  .home-preview-heading {
    font-size: clamp(1.65rem, 4vw, 2.25rem);
    letter-spacing: -0.03em;
    color: var(--text-bright);
  }

  .home-preview-heading-link {
    text-decoration: none;
    color: inherit;
    border-radius: 6px;
    margin-inline: -0.15rem;
    padding-inline: 0.15rem;
  }

  .home-preview-heading-link:hover {
    color: var(--accent);
  }

  .home-preview-heading-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .home-preview-subtitle {
    font-size: 1.05rem;
    color: var(--text-main);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .home-preview-empty {
    font-size: 0.95rem;
    color: var(--text-main);
    opacity: 0.85;
    margin-bottom: 1rem;
  }

  /* Project cards grid */
  .project-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    cursor: pointer;
    padding: 1.25rem;
  }

  .project-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }

  .project-category-badge {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--badge-color);
    background: color-mix(in srgb, var(--badge-color) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--badge-color) 20%, transparent);
  }

  .project-card-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-main);
    opacity: 0.6;
    white-space: nowrap;
  }

  .project-card-title {
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--text-bright);
    margin: 0 0 0.45rem;
    line-height: 1.3;
    transition: color 0.15s ease;
  }

  .project-card:hover .project-card-title {
    color: var(--accent);
  }

  .project-card-desc {
    font-size: 0.88rem;
    color: var(--text-main);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Garden text list */
  .home-preview-list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    border-top: 1px solid var(--card-border);
  }

  .home-preview-list li {
    margin: 0;
    border-bottom: 1px solid var(--card-border);
  }

  .home-preview-row {
    display: grid;
    grid-template-columns: minmax(5.5rem, 7.25rem) minmax(0, 1fr);
    gap: 0.65rem 1.15rem;
    align-items: baseline;
    padding: 0.75rem 0;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s ease;
    border-radius: 6px;
    margin-inline: -0.25rem;
    padding-inline: 0.25rem;
  }

  @media (max-width: 480px) {
    .home-preview-row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  .home-preview-row:hover {
    background: color-mix(in srgb, var(--card-bg) 65%, transparent);
  }

  .home-preview-row:hover .home-preview-title {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .home-preview-row:hover .home-preview-time {
    color: var(--text-main);
  }

  .home-preview-time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-main);
    white-space: nowrap;
  }

  .home-preview-title {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--accent-link, var(--accent));
    line-height: 1.35;
    transition: color 0.12s ease;
  }

  .home-preview-view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-main);
    text-decoration: none;
  }

  .home-preview-view-all:hover {
    color: var(--accent);
  }

  .home-preview-view-all-arrow {
    transition: transform 0.15s ease;
  }

  .home-preview-view-all:hover .home-preview-view-all-arrow {
    transform: translateX(3px);
  }

  .home-resume-lead {
    font-size: 1rem;
    color: var(--text-main);
    line-height: 1.65;
    max-width: 36rem;
  }

  .home-resume-lead a {
    color: var(--accent-link, var(--accent));
    font-weight: 600;
    text-decoration: none;
  }

  .home-resume-lead a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
