---
import { site } from '../data/site';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Projects', href: '/projects' },
  { label: 'Garden', href: '/garden' },
  { label: 'Resume', href: '/resume' },
];

const currentPath = Astro.url.pathname;
---

<aside id="site-sidebar" class="sidebar" aria-label="Site navigation">
  <div class="sidebar-inner">
    <a href="/" class="logo">{site.name.split(' ').map((chunk) => chunk[0]).join('').slice(0, 4).toUpperCase()}</a>
    <nav aria-label="Primary">
      <ul class="nav-stack">
        {navItems.map((item) => {
          const isActive =
            item.href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(item.href);

          return (
            <li>
              <a href={item.href} class:list={[{ active: isActive }]}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="social-stack" aria-label="Social links">
      <a href={`mailto:${site.contact.email}`} class="social-chip" title="Email">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </a>
      <a href={site.contact.github} class="social-chip" title="GitHub" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
      </a>
      <a href={site.contact.linkedin} class="social-chip" title="LinkedIn" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
      </a>
      <a href={site.contact.instagram} class="social-chip" title="Instagram" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><circle cx="17.5" cy="6.5" r="1"/></svg>
      </a>
    </div>

    <button type="button" class="theme-chip" data-theme-toggle aria-live="polite">
      Toggle theme
    </button>

    <button
      type="button"
      class="desktop-sidebar-trigger"
      id="desktop-sidebar-toggle"
      aria-pressed="false"
    >
      Hide sidebar
    </button>
  </div>
</aside>

<style>
  .sidebar {
    isolation: isolate;
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: var(--shell-gap);
    min-height: 100vh;
  }

  @media (max-width: 767px) {
    .sidebar-inner {
      min-height: 100%;
      padding-block: calc(var(--shell-gap) + 4px);
    }
  }

  .logo {
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--text-bright);
    letter-spacing: -0.05em;
  }

  .nav-stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .nav-stack a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-main);
    padding: 0.4rem 0;
    margin-left: -0.4rem;
    padding-left: 0.85rem;
    border-left: 2px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .nav-stack a:hover,
  .nav-stack a.active {
    color: var(--text-bright);
    border-left-color: var(--accent);
  }

  .social-stack {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.35rem;
  }

  .social-chip {
    display: grid;
    place-items: center;
    width: 2.65rem;
    height: 2.65rem;
    border-radius: 10px;
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    color: var(--text-main);
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      background 0.15s ease;
  }

  .social-chip svg {
    display: block;
  }

  .social-chip:hover {
    color: var(--accent);
    border-color: rgba(252, 170, 45, 0.45);
    transform: translateY(-1px);
  }

  .social-chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .theme-chip {
    margin-top: auto;
  }
</style>

<script>
  import '../scripts/shell.ts';
</script>
