---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile.png';
import { interests } from '../data/interests';
import { site } from '../data/site';

const first = site.name.split(' ')[0] ?? site.name;
---

<section class="home-hero" aria-label="Introduction">
  <div class="home-hero-inner">
    <div class="home-hero-copy">
      <p class="home-hero-greeting">Hey, I'm</p>
      <h1 class="home-hero-title">{first}<span class="accent-dot">.</span></h1>
      <p class="home-hero-lede">
        MIT student building things from wood, leather, and code.
        I like figuring out how systems work and making tools that feel good to use.
      </p>
      <div class="home-hero-interests" aria-label="Current interests">
        {interests.map((tag) => (
          <a class="interest-tag" href={`/interests/${tag.slug}`} style={`--tag-color: ${tag.color}`}>
            {tag.label}
          </a>
        ))}
      </div>
      <div class="home-hero-actions">
        <a href="/resume" class="home-hero-btn home-hero-btn-primary">
          <svg class="home-hero-btn-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" x2="8" y1="13" y2="13" />
            <line x1="16" x2="8" y1="17" y2="17" />
            <polyline points="10 9 9 9 8 9" />
          </svg>
          Resume
        </a>
        <button
          type="button"
          class="home-hero-btn"
          data-copy-email={site.contact.email}
          aria-label="Copy email address"
        >
          <svg class="home-hero-btn-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
          Email me
        </button>
      </div>
    </div>
    <div class="home-hero-visual">
      <div class="home-hero-photo-ring">
        <Image
          class="home-hero-photo"
          src={profilePhoto}
          alt={site.name}
          width={280}
          height={280}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    padding-block: clamp(1rem, 3vw, 2rem);
    color: var(--text-main);
  }

  .home-hero-inner {
    max-width: min(56rem, 100%);
    margin-inline: auto;
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 768px) {
    .home-hero-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      justify-content: space-between;
    }
  }

  .home-hero-greeting {
    margin: 0 0 0.15rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-main);
    letter-spacing: 0.01em;
    opacity: 0;
    animation: fadeSlideIn 0.5s ease 0.1s forwards;
  }

  .home-hero-title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.5rem, 5.5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--text-bright);
    opacity: 0;
    animation: fadeSlideIn 0.5s ease 0.2s forwards;
  }

  .accent-dot {
    color: var(--accent);
  }

  .home-hero-lede {
    margin: 0 0 1.25rem;
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 34rem;
    opacity: 0;
    animation: fadeSlideIn 0.5s ease 0.3s forwards;
  }

  .home-hero-lede a {
    color: var(--accent-link, var(--accent));
    text-decoration: none;
    font-weight: 600;
  }

  .home-hero-lede a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .home-hero-interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeSlideIn 0.5s ease 0.4s forwards;
  }

  .interest-tag {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--tag-color);
    background: color-mix(in srgb, var(--tag-color) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--tag-color) 25%, transparent);
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  .interest-tag:hover,
  .interest-tag:focus-visible {
    color: var(--tag-color);
    background: color-mix(in srgb, var(--tag-color) 20%, transparent);
    border-color: color-mix(in srgb, var(--tag-color) 40%, transparent);
    transform: translateY(-1px);
  }

  .interest-tag:focus-visible {
    outline: 2px solid var(--tag-color);
    outline-offset: 2px;
  }

  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    opacity: 0;
    animation: fadeSlideIn 0.5s ease 0.5s forwards;
  }

  .home-hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.1rem;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-sans);
    color: var(--text-bright);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;
  }

  .home-hero-btn:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    color: var(--accent);
    background: var(--bg-overlay, var(--card-bg));
    transform: translateY(-1px);
  }

  .home-hero-btn-primary {
    background: var(--accent);
    color: var(--bg-color);
    border-color: var(--accent);
  }

  .home-hero-btn-primary:hover {
    background: color-mix(in srgb, var(--accent) 85%, black);
    color: var(--bg-color);
    border-color: color-mix(in srgb, var(--accent) 85%, black);
  }

  .home-hero-btn-icon {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .home-hero-visual {
    display: flex;
    justify-content: center;
    opacity: 0;
    animation: fadeScaleIn 0.6s ease 0.3s forwards;
  }

  @media (min-width: 768px) {
    .home-hero-visual {
      justify-content: flex-end;
    }
  }

  .home-hero-photo-ring {
    width: min(220px, 70vw);
    height: min(220px, 70vw);
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 18%, var(--bg-color));
    display: grid;
    place-items: center;
    padding: 6px;
    box-sizing: border-box;
    border: 2px solid color-mix(in srgb, var(--accent) 35%, transparent);
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .home-hero-photo-ring:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .home-hero-photo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    filter: brightness(0.88) contrast(1.05);
  }

  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeScaleIn {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-greeting,
    .home-hero-title,
    .home-hero-lede,
    .home-hero-interests,
    .home-hero-actions,
    .home-hero-visual {
      opacity: 1;
      animation: none;
    }

    .interest-tag:hover,
    .interest-tag:focus-visible {
      transform: none;
    }
  }
</style>
