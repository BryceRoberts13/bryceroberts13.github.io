---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'garden'>[];
  /** Zero-based offset so stagger continues across stacked lists */
  animationOffset?: number;
}

const { posts, animationOffset = 0 } = Astro.props;
---

{
  posts.map((post, index) => {
    const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });
    return (
      <a
        href={`/garden/${post.id}`}
        class="post-item glass-card fade-in-up"
        style={`animation-delay: ${0.1 * (animationOffset + index + 1)}s;`}
      >
        <div class="post-meta">
          <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
          {post.data.tags && post.data.tags.length > 0 ? (
            <div class="tags">
              {post.data.tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          ) : null}
        </div>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
      </a>
    );
  })
}

<style>
  .post-item {
    display: block;
    text-decoration: none;
    cursor: pointer;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-main);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    color: var(--accent);
  }

  .post-item h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-bright);
    transition: color 0.2s ease;
  }

  .post-item:hover h2 {
    color: var(--accent);
  }

  .post-item p {
    color: var(--text-main);
    margin: 0;
  }

  .fade-in-up {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-in-up {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
