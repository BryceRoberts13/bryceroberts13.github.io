---
import SectionGlyph from '../components/SectionGlyph.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Resume | Bryce Roberts">
  <section class="page-header">
    <div class="header-content fade-in-up">
      <div class="header-top">
        <h1 class="heading-with-icon">
          <SectionGlyph kind="resume" size={42} />
          Resume
        </h1>
        <div class="header-actions">
          <a href="/resume.pdf" target="_blank" class="primary-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Download PDF
          </a>
          <a href={`mailto:${site.contact.email}`} class="glass-btn">Contact Me</a>
        </div>
      </div>
      <div class="divider"></div>
      <p class="subtitle">Artificial intelligence, mathematics, research, software engineering, and technical craft.</p>
    </div>
  </section>

  <div class="resume-content fade-in-up" style="animation-delay: 0.1s;">
    <!-- Education Section -->
    <section class="resume-section">
      <h2 class="section-title">Education</h2>
      <div class="resume-item glass-card">
        <div class="item-header">
          <h3>Massachusetts Institute of Technology</h3>
          <span class="date">Aug 2023 - May 2027</span>
        </div>
        <div class="item-details">
          <p class="role">B.S. in Artificial Intelligence &amp; Decision Making and Mathematics · GPA: 4.6/5.0</p>
          <ul class="achievements">
            <li>
              Relevant coursework includes Design and Analysis of Algorithms, Graduate Machine Learning,
              Graduate Non-Linear Optimization, Statistics, Discrete Probability and Stochastic Processes,
              Theory of Computation, Distributed Algorithms, Linear Algebra, Representation, Inference, and
              Reasoning in AI, Strategy and Information, Mathematical Economic Modeling, and Algebraic
              Combinatorics.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section class="resume-section">
      <h2 class="section-title">Experience</h2>

      <div class="resume-item glass-card">
        <div class="item-header">
          <h3>Research Intern</h3>
          <span class="date">Fall 2025</span>
        </div>
        <div class="item-details">
          <p class="role">General Intelligence Company — New York, NY (remote)</p>
          <ul class="achievements">
            <li>Developing novel benchmarks to evaluate long-context memory capabilities in large language models.</li>
            <li>Designing and implementing experiments to gauge and improve LLM performance on extended memory tasks.</li>
          </ul>
        </div>
      </div>

      <div class="resume-item glass-card">
        <div class="item-header">
          <h3>Software Engineer</h3>
          <span class="date">Jan 2025 – Aug 2025</span>
        </div>
        <div class="item-details">
          <p class="role">Contraca — Boston, MA</p>
          <ul class="achievements">
            <li>Built scalable backend systems and APIs powering dynamic content generation, distribution, and front-end interactivity.</li>
            <li>Developed web scrapers feeding automated content pipelines.</li>
            <li>Worked with clients on product direction; attended industry events for market and technology signals.</li>
          </ul>
        </div>
      </div>

      <div class="resume-item glass-card">
        <div class="item-header">
          <h3>Research Collaborator</h3>
          <span class="date">Spring 2025</span>
        </div>
        <div class="item-details">
          <p class="role">Massachusetts Institute of Technology</p>
          <ul class="achievements">
            <li>
              Researching spoof detection using CLIP embeddings with contrastive and triplet learning,
              optimizing similarity metrics and evaluations.
            </li>
            <li>Assisting in writing and preparing a research paper for publication.</li>
          </ul>
        </div>
      </div>

      <div class="resume-item glass-card">
        <div class="item-header">
          <h3>Research Intern</h3>
          <span class="date">Jul 2023 – Aug 2023</span>
        </div>
        <div class="item-details">
          <p class="role">Tier 1 Alpha — San Francisco, CA</p>
          <ul class="achievements">
            <li>Researched and wrote financial blogs explaining options strategies and core concepts for clients.</li>
            <li>Automated parts of the content workflow to speed production and tailor delivery.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Accolades Section -->
    <section class="resume-section">
      <h2 class="section-title">Leadership / Extracurricular</h2>

      <div class="resume-item glass-card">
        <div class="item-header">
          <h3>Varsity Swim</h3>
          <span class="date">Sep 2023 - Present</span>
        </div>
        <div class="item-details">
          <p class="role">Member · Massachusetts Institute of Technology</p>
          <ul class="achievements">
            <li>Won the 100m Butterfly at the NEWMAC Championship, setting a conference record.</li>
            <li>Awarded Rookie Athlete of the Year for exceptional performance in debut season.</li>
            <li>Competed in four relay events and two individual events at NCAAs, contributing to the team's performance.</li>
          </ul>
        </div>
      </div>

      <div class="resume-item glass-card">
        <div class="item-header">
          <h3>Ring Committee</h3>
          <span class="date">Spring 2024 - Spring 2025</span>
        </div>
        <div class="item-details">
          <p class="role">Artist and Study Break Chair · Massachusetts Institute of Technology</p>
          <ul class="achievements">
            <li>Worked with a 12-member committee to design MIT's class ring to reflect the class's values and experiences.</li>
            <li>Planned and led the Study Break event to gather class input and shape the final ring design.</li>
            <li>Coordinated communications with vendors and committees for ring design presentation and delivery events.</li>
          </ul>
        </div>
      </div>

    </section>

    <!-- Projects Section -->
    <section class="resume-section">
      <h2 class="section-title">Projects</h2>

      <div class="resume-item glass-card">
        <div class="item-header">
          <h3>Targeted Lobbying on Council Networks</h3>
          <span class="date">Spring 2026</span>
        </div>
        <div class="item-details">
          <p class="role">MIT 14.18 Mathematical Economic Modeling</p>
          <ul class="achievements">
            <li>
              Coauthored final paper modeling a budget-constrained lobbyist on a legislature with network strategic
              complementarities and a passage institution mapping members' actions into adoption probability.
            </li>
            <li>
              Showed how linear aggregation and smooth strictly increasing passage rules lead to different optimal
              targeting centralities.
            </li>
            <li>
              Embedded a linear-quadratic network game, worked closed-form small-network examples, and developed
              extensions for bounded actions and probabilistic voting.
            </li>
          </ul>
        </div>
      </div>

      <div class="resume-item glass-card">
        <div class="item-header">
          <h3>Custom Keyboard Optimization</h3>
          <span class="date">Summer 2024</span>
        </div>
        <div class="item-details">
          <p class="role">QMK, Karabiner, Bash, AppleScript</p>
          <ul class="achievements">
            <li>Implemented a leader key with programmable scripts and custom key remappings to optimize workflow efficiency.</li>
            <li>Applied QMK firmware, Karabiner-Elements, Bash, and AppleScript for deep system customization.</li>
          </ul>
        </div>
      </div>

      <div class="resume-item glass-card">
        <div class="item-header">
          <h3>Personal Portfolio Website</h3>
          <span class="date">June 2025</span>
        </div>
        <div class="item-details">
          <p class="role">React.js, CSS · bryceroberts13.github.io</p>
          <ul class="achievements">
            <li>Developed a responsive portfolio site with a modern UI for projects and professional experience.</li>
            <li>Designed and implemented interactive components to present technical work and background.</li>
          </ul>
        </div>
      </div>

      <div class="resume-item glass-card">
        <div class="item-header">
          <h3>Sepsis Early Detection with Machine Learning</h3>
          <span class="date">December 2024</span>
        </div>
        <div class="item-details">
          <p class="role">MIT 6.790 Graduate Machine Learning</p>
          <ul class="achievements">
            <li>Developed predictive models on ICU patient time-series data to detect sepsis up to 12 hours before clinical diagnosis.</li>
            <li>
              Implemented missing data strategies, class imbalance handling, and utility-aware loss functions to optimize
              clinically relevant predictions.
            </li>
            <li>Compared logistic regression and recurrent neural networks, achieving 82% accuracy with an RNN.</li>
          </ul>
        </div>
      </div>

      <div class="resume-item glass-card">
        <div class="item-header">
          <h3>Fractional Coloring Presentation</h3>
          <span class="date">February 2023</span>
        </div>
        <div class="item-details">
          <p class="role">Research presentation</p>
          <ul class="achievements">
            <li>
              Conducted research on fractional coloring, proving multiple theorems about the fractional chromatic
              number of a special class of graphs.
            </li>
          </ul>
        </div>
      </div>

      <div class="resume-item glass-card">
        <div class="item-header">
          <h3>Instagram Web Scraper</h3>
          <span class="date">June 2023</span>
        </div>
        <div class="item-details">
          <p class="role">Python, Selenium, BeautifulSoup</p>
          <ul class="achievements">
            <li>Developed a web scraper to automate retrieval and storage of friends' Instagram posts.</li>
            <li>Implemented scraping techniques to handle dynamic content loading and extract structured data.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section class="resume-section">
      <h2 class="section-title">Skills</h2>
      <div class="skills-grid glass-card">
        <div class="skill-category">
          <h3>Languages</h3>
          <p>Python, HTML/CSS, TypeScript, Bash Scripting, C, AppleScript</p>
        </div>
        <div class="skill-category">
          <h3>Developer Tools</h3>
          <p>Terminal, VS Code, Jupyter Notebooks, Git, GitHub, UV</p>
        </div>
        <div class="skill-category">
          <h3>Libraries / Frameworks</h3>
          <p>NumPy, Pandas, Matplotlib, SciPy, PyTorch, Selenium with Python, BeautifulSoup</p>
        </div>
        <div class="skill-category">
          <h3>Research Areas</h3>
          <p>LLM benchmarking, CLIP embeddings, contrastive learning, triplet learning, time-series modeling</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 4rem;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    letter-spacing: -0.02em;
    color: var(--text-bright);
    margin: 0;
  }

  .glass-btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 6px;
    color: var(--text-bright);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s ease;
    backdrop-filter: blur(10px);
  }

  .glass-btn:hover {
    background: rgba(252, 170, 45, 0.1);
    border-color: rgba(252, 170, 45, 0.4);
    color: var(--accent);
  }

  .primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 6px;
    color: var(--bg-dark);
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .primary-btn:hover {
    background: var(--text-bright);
    border-color: var(--text-bright);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(252, 170, 45, 0.3);
  }

  .header-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .icon {
    flex-shrink: 0;
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--text-main);
    margin-top: 1.5rem;
  }

  .divider {
    height: 3px;
    width: 60px;
    background: var(--accent);
    border-radius: 2px;
  }

  .resume-section {
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 1.5rem;
    color: var(--text-bright);
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .resume-item {
    padding: 2rem;
    margin-bottom: 1.5rem;
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .item-header h3 {
    font-size: 1.25rem;
    color: var(--text-bright);
    margin: 0;
  }

  .date {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
  }

  .role {
    font-weight: 500;
    color: var(--text-main);
    margin-bottom: 1rem;
  }

  .achievements {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }

  .achievements li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-main);
    font-size: 0.95rem;
  }

  .achievements li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    padding: 2rem;
  }

  .skill-category h3 {
    font-size: 1rem;
    color: var(--text-bright);
    margin-bottom: 0.5rem;
  }

  .skill-category p {
    color: var(--text-main);
    font-size: 0.95rem;
    font-family: var(--font-mono);
  }

  .fade-in-up {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
