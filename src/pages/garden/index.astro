---
import GardenPostList from '../../components/GardenPostList.astro';
import SectionGlyph from '../../components/SectionGlyph.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const PATCH_NOTES_TAG = 'patch-notes';

const posts = await getCollection('garden');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const patchPosts = posts.filter((p) => p.data.tags?.includes(PATCH_NOTES_TAG));
const mainPosts = posts.filter((p) => !p.data.tags?.includes(PATCH_NOTES_TAG));
---

<BaseLayout title="Digital Garden | Bryce Roberts">
  <section class="page-header">
    <div class="header-content fade-in-up">
      <h1 class="heading-with-icon">
        <SectionGlyph kind="garden" size={42} />
        Digital Garden
      </h1>
      <div class="divider"></div>
      <p class="subtitle">Thoughts, patch notes, and technical deep dives.</p>
    </div>
  </section>

  <section class="blog-section" aria-labelledby="blog-heading">
    <h2 id="blog-heading" class="garden-section-heading">Blog</h2>
    {mainPosts.length > 0 ? (
      <div class="posts-list">
        <GardenPostList posts={mainPosts} animationOffset={0} />
      </div>
    ) : (
      <p class="blog-empty">Nothing here yet.</p>
    )}
  </section>

  <section class="patch-notes-section" aria-labelledby="patch-notes-heading">
    <h2 id="patch-notes-heading" class="garden-section-heading">Patch notes</h2>
    <p class="patch-notes-lede">
      Small site and workflow changes. Tag garden posts with <code>patch-notes</code> to list them here.
    </p>
    {patchPosts.length > 0 ? (
      <div class="posts-list patch-notes-list">
        <GardenPostList posts={patchPosts} animationOffset={mainPosts.length} />
      </div>
    ) : (
      <p class="patch-notes-empty">Nothing here yet.</p>
    )}
  </section>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 4rem;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
    color: var(--text-bright);
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--text-main);
    margin-top: 1.5rem;
  }

  .divider {
    height: 3px;
    width: 60px;
    background: var(--accent);
    border-radius: 2px;
  }

  .blog-section {
    margin-bottom: 0;
  }

  .blog-empty {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .garden-section-heading {
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
    color: var(--text-bright);
  }

  .patch-notes-section {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--card-border);
  }

  .patch-notes-lede {
    font-size: 0.95rem;
    color: var(--text-main);
    margin: 0 0 1.5rem;
    max-width: 42rem;
    line-height: 1.6;
  }

  .patch-notes-lede code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    color: var(--accent);
  }

  .patch-notes-empty {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .patch-notes-list {
    margin-top: 0;
  }

  .post-item {
    display: block;
    text-decoration: none;
    cursor: pointer;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-main);
  }

  .tags {
    display: flex;
    gap: 0.5rem;
  }

  .tag {
    color: var(--accent);
  }

  .post-item h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-bright);
    transition: color 0.2s ease;
  }

  .post-item:hover h2 {
    color: var(--accent);
  }

  .post-item p {
    color: var(--text-main);
    margin: 0;
  }

  .fade-in-up {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
