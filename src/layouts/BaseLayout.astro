---
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
}

const { title = 'Bryce Roberts' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      try {
        var k = 'br-site-theme';
        var saved = localStorage.getItem(k);
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute(
          'data-theme',
          saved === 'light' || saved === 'dark' ? saved : prefersDark ? 'dark' : 'light',
        );
      } catch (_) {}
    </script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <div class="app-shell" data-drawer-open="false" data-sidebar-collapsed="false">
      <script is:inline>
        (function () {
          try {
            var mq = window.matchMedia('(min-width:768px)');
            if (!mq.matches) return;
            if (localStorage.getItem('br-site-sidebar-collapsed') === 'true') {
              var shell = document.querySelector('.app-shell');
              if (shell) shell.dataset.sidebarCollapsed = 'true';
            }
          } catch (_) {}
        })();
      </script>

      <div class="drawer-backdrop" aria-hidden="true"></div>
      <Sidebar />
      <div class="content-wrap">
        <div class="top-mobile-bar">
          <button
            type="button"
            id="mobile-open-menu"
            class="mobile-menu-trigger"
            aria-label="Open site menu"
            aria-expanded="false"
            aria-controls="site-sidebar"
          >
            Menu
          </button>
        </div>

        <main id="main-content">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
