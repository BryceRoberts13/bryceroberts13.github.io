---
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
}

const { title = 'Bryce Roberts' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      try {
        var k = 'br-site-theme';
        var saved = localStorage.getItem(k);
        document.documentElement.setAttribute(
          'data-theme',
          saved === 'light' || saved === 'dark' ? saved : 'light',
        );
      } catch (_) {}
    </script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <div class="app-shell" data-drawer-open="false" data-sidebar-collapsed="false" data-rail-layout="false">
      <script is:inline>
        (function () {
          try {
            var mq = window.matchMedia('(min-width:768px)');
            if (!mq.matches) return;
            if (localStorage.getItem('br-site-sidebar-collapsed') === 'true') {
              var shell = document.querySelector('.app-shell');
              if (shell) {
                shell.dataset.sidebarCollapsed = 'true';
                shell.dataset.railLayout = 'true';
              }
            }
          } catch (_) {}
        })();
      </script>

      <div class="drawer-backdrop" aria-hidden="true"></div>
      <Sidebar />
      <div class="content-wrap">
        <main id="main-content">
          <slot />
        </main>
      </div>
      <div class="shell-drawer-anchor">
        <button
          type="button"
          id="mobile-open-menu"
          class="shell-drawer-fab"
          aria-label="Open site menu"
          aria-expanded="false"
          aria-controls="site-sidebar"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" x2="19" y1="8" y2="8" />
            <line x1="8" x2="16" y1="12" y2="12" />
            <line x1="10" x2="14" y1="16" y2="16" />
          </svg>
        </button>
      </div>
    </div>
  </body>
</html>
